{
  "$comment": "Make expressions substituted for %name% after the Handlebars render (so Handlebars never escapes their quotes). Sample values feed the local preview.",
  "firstName": {
    "make": "{{1.user.firstName}}",
    "sample": "Camille"
  },
  "email": {
    "make": "{{1.user.email}}",
    "sample": "camille@example.ch"
  },
  "phone": {
    "make": "{{1.user.phone.international}}",
    "sample": "+41 79 123 45 67"
  },
  "ref": {
    "make": "{{1.submission.ref}}",
    "sample": "P / BATTERIE / DUPONT / 1003 Lausanne / 2026-10-03"
  },
  "requestUrl": {
    "make": "{{1.submission.request_url}}",
    "sample": "https://easyrecharge.ch/fr/devis-batterie-solaire/demande/00000000"
  },
  "date": {
    "make": "{{formatDate(1.submission.submittedAt; \"DD.MM.YYYY\")}}",
    "sample": "03.10.2026"
  },
  "place": {
    "make": "{{1.submission.data.postalCode}} {{1.submission.data.locality}}",
    "sample": "1003 Lausanne"
  },
  "locality": {
    "make": "{{1.submission.data.locality}}",
    "sample": "Lausanne"
  },
  "partner": {
    "make": "{{1.dispatch.targets[1].displayName}}",
    "sample": "E-ME Énergies"
  },
  "productFr": {
    "make": "{{if(1.submission.product = \"battery\"; \"Batterie solaire\"; \"Borne de recharge\")}}",
    "sample": "Batterie solaire"
  },
  "productDe": {
    "make": "{{if(1.submission.product = \"battery\"; \"Solarbatterie\"; \"Ladestation\")}}",
    "sample": "Solarbatterie"
  },
  "productEn": {
    "make": "{{if(1.submission.product = \"battery\"; \"Solar battery\"; \"EV charging station\")}}",
    "sample": "Solar battery"
  },
  "forProductFr": {
    "make": "{{if(1.submission.product = \"battery\"; \"pour une batterie solaire\"; \"pour une borne de recharge\")}}",
    "sample": "pour une batterie solaire"
  },
  "forProductDe": {
    "make": "{{if(1.submission.product = \"battery\"; \"für eine Solarbatterie\"; \"für eine Ladestation\")}}",
    "sample": "für eine Solarbatterie"
  },
  "forProductEn": {
    "make": "{{if(1.submission.product = \"battery\"; \"for a solar battery\"; \"for an EV charging station\")}}",
    "sample": "for a solar battery"
  },
  "installerSearchFr": {
    "make": "https://business-monitor.ch/fr/list-builder?filters%5Bdistance_from%5D%5B1760278808078%5D%5Bzip_center%5D={{1.submission.data.postalCode}}&filters%5Bdistance_from%5D%5B1760278808078%5D%5Bzip_center_km%5D=5&filters%5Bdistance_from_operator%5D=OR&filters%5Bnoga_ids%5D%5B%5D=848&page=1",
    "sample": "https://business-monitor.ch/fr/list-builder"
  },
  "installerSearchDe": {
    "make": "https://business-monitor.ch/de/list-builder?filters%5Bdistance_from%5D%5B1760278808078%5D%5Bzip_center%5D={{1.submission.data.postalCode}}&filters%5Bdistance_from%5D%5B1760278808078%5D%5Bzip_center_km%5D=5&filters%5Bdistance_from_operator%5D=OR&filters%5Bnoga_ids%5D%5B%5D=848&page=1",
    "sample": "https://business-monitor.ch/de/list-builder"
  },
  "productShortFr": {
    "make": "{{if(1.submission.product = \"battery\"; \"Batterie\"; \"Borne\")}}",
    "sample": "Batterie"
  },
  "actionContacted": {
    "make": "{{1.dispatch.targets[1].actionUrls.contacted}}",
    "sample": "https://easyrecharge.ch/partners/action/sample-contacted"
  },
  "actionDisqualify": {
    "make": "{{1.dispatch.targets[1].actionUrls.disqualify}}",
    "sample": "https://easyrecharge.ch/partners/action/sample-disqualify"
  },
  "rFirstName": {
    "make": "{{1.lead.first_name}}",
    "sample": "Camille"
  },
  "rLastName": {
    "make": "{{1.lead.last_name}}",
    "sample": "Dupont"
  },
  "rPhone": {
    "make": "{{1.lead.phone}}",
    "sample": "+41 79 123 45 67"
  },
  "rRef": {
    "make": "{{1.lead.ref}}",
    "sample": "P / BORNE / DUPONT / 1003 Lausanne / 2026-10-13"
  },
  "rPlace": {
    "make": "{{1.lead.postal_code}} {{1.lead.locality}}",
    "sample": "1003 Lausanne"
  },
  "rLocality": {
    "make": "{{1.lead.locality}}",
    "sample": "Lausanne"
  },
  "rDays": {
    "make": "{{1.days_in_stage}}",
    "sample": "5"
  },
  "rDate": {
    "make": "{{formatDate(1.lead.dispatched_at; \"DD.MM.YYYY\")}}",
    "sample": "13.10.2026"
  },
  "rProductFr": {
    "make": "{{if(1.lead.product = \"battery\"; \"Batterie solaire\"; \"Borne de recharge\")}}",
    "sample": "Borne de recharge"
  },
  "rProductDe": {
    "make": "{{if(1.lead.product = \"battery\"; \"Solarbatterie\"; \"Ladestation\")}}",
    "sample": "Ladestation"
  },
  "rCrmUrl": {
    "make": "{{1.partner.crmUrl}}",
    "sample": "https://easyrecharge.ch/fr/partners/sample/leads"
  },
  "rActionContacted": {
    "make": "{{1.actionUrls.contacted}}",
    "sample": "https://easyrecharge.ch/partners/action/sample-contacted"
  },
  "rActionAppointment": {
    "make": "{{1.actionUrls.appointment}}",
    "sample": "https://easyrecharge.ch/partners/action/sample-appointment"
  },
  "rActionQuoteSent": {
    "make": "{{1.actionUrls.quote_sent}}",
    "sample": "https://easyrecharge.ch/partners/action/sample-quote-sent"
  },
  "rActionWon": {
    "make": "{{1.actionUrls.won}}",
    "sample": "https://easyrecharge.ch/partners/action/sample-won"
  },
  "rActionLost": {
    "make": "{{1.actionUrls.lost}}",
    "sample": "https://easyrecharge.ch/partners/action/sample-lost"
  },
  "threadMessageId": {
    "make": "{{1.dispatch.targets[1].threadMessageId}}",
    "sample": "<lead-00000000@easyrecharge.ch>"
  },
  "rThreadId": {
    "make": "{{1.thread_message_id}}",
    "sample": "<lead-00000000@easyrecharge.ch>"
  },
  "rProductShortFr": {
    "make": "{{if(1.lead.product = \"battery\"; \"Batterie\"; \"Borne\")}}",
    "sample": "Borne"
  }
}
